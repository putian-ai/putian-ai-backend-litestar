# App
SECRET_KEY='secret-key'
LITESTAR_DEBUG=true
LITESTAR_HOST=0.0.0.0
LITESTAR_PORT=8000
APP_URL=http://localhost:${LITESTAR_PORT}

LOG_LEVEL=20
# Database
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_DISABLE=false
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=30
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

ALLOWED_CORS_ORIGINS=["localhost:3006","localhost:8080","localhost:8000"]

# Memory queue (Redis)
MEMORY_QUEUE_ENABLED=true
MEMORY_QUEUE_URL=redis://redis:6379/0
MEMORY_QUEUE_NAME=memory_updates
MEMORY_QUEUE_MAX_RETRIES=3
MEMORY_QUEUE_JOB_TIMEOUT=120
MEMORY_QUEUE_WORKER_ENABLED=true
